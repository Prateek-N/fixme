# CORS — comma-separated list of allowed frontend origins (leave blank for localhost dev defaults)
ALLOWED_ORIGINS=https://yourdomain.com

# Feedback storage — absolute path for persistent suggestions log (defaults to suggestions.json in cwd)
SUGGESTIONS_FILE=/data/suggestions.json

# Admin email for feedback notifications (requires RESEND_API_KEY)
ADMIN_EMAIL=you@yourdomain.com

# Optional: Resend API key for email notifications on new feedback
RESEND_API_KEY=
